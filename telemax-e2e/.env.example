# Copy sang .env rồi điền. .env KHÔNG được commit.

BASE_URL=https://dashboard-stage.telemax.com.au

# Tài khoản test trên staging. Dùng account riêng cho QA, đừng dùng account cá nhân.
TELEMAX_USER=
TELEMAX_PASS=

# ── PRODUCTION ────────────────────────────────────────────────────────────────
# Chỉ dùng cho bước verify sau khi deploy. Trên prod CHỈ chạy case gắn @prod-safe
# (case chỉ xem, không sửa dữ liệu) — xem README.
PROD_BASE_URL=https://dashboard.telemax.com.au

# Account riêng cho QA trên prod, quyền thấp nhất đủ để xem.
# ĐỪNG dùng account admin, và đừng dùng chung account với staging.
TELEMAX_PROD_USER=
TELEMAX_PROD_PASS=

# ── FORM ĐĂNG NHẬP ───────────────────────────────────────────────────────────
# Chỉ cần sửa khi app KHÔNG phải Telemax dashboard, hoặc form login đã đổi. Bỏ trống
# thì `.claude/scripts/seed-mcp-profile.mjs` dùng mặc định là các giá trị dưới.
# Không phải secret — để ở đây vì script đã đọc file này rồi.
#
# Tiền tố chọn cách tìm phần tử:
#   placeholder:<text>   (mặc định nếu không có tiền tố)
#   label:<text>  ·  testid:<id>  ·  text:<text>  ·  css:<selector>
#   role:<vai>/<tên>     VD role:button/Login
#
# LOGIN_PATH=/login
# LOGIN_EMAIL=placeholder:Enter your email
# LOGIN_PASSWORD=placeholder:Enter your password
# LOGIN_SUBMIT=role:button/Login
# LOGIN_2FA=role:heading/Two-Factor Authentication
# LOGIN_REMEMBER=role:checkbox/Remember this device

# Copy sang .env rồi điền. .env KHÔNG được commit.

BASE_URL=https://dashboard-stage.telemax.com.au

# Tài khoản test trên staging. Dùng account riêng cho QA, đừng dùng account cá nhân.
TELEMAX_USER=
TELEMAX_PASS=

# ── PRODUCTION ────────────────────────────────────────────────────────────────
# Chỉ dùng cho bước verify sau khi deploy. Trên prod CHỈ chạy case gắn @prod-safe
# (case chỉ xem, không sửa dữ liệu) — xem README.
PROD_BASE_URL=https://dashboard.telemax.com.au

# Account riêng cho QA trên prod, quyền thấp nhất đủ để xem.
# ĐỪNG dùng account admin, và đừng dùng chung account với staging.
TELEMAX_PROD_USER=
TELEMAX_PROD_PASS=
